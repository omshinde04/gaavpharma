{
  "name": "gaavpharma",
  "version": "1.0.0",
  "description": "Offline Desktop POS for Pharmacy & General Stores",
  "main": "electron/main.js",
  "author": "Om Shinde <Shindeom052@gmail.com>",
  "license": "ISC",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "dev:web": "vite",
    "test": "node test_workflow.js",
    "test:sqlite": "ELECTRON_RUN_AS_NODE=1 electron test_electron_db.js && ELECTRON_RUN_AS_NODE=1 electron audit_sql.js",
    "build": "vite build",
    "build:electron": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win nsis",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.gaavpharma.pos",
    "productName": "GaavPharma POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
